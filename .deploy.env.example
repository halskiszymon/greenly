# Copy to .deploy.env (gitignored) and fill in. Used by scripts/deploy.py only.
DEPLOY_HOST=ftp.example.com
DEPLOY_USER=
DEPLOY_PASS=
# Remote application root — the folder that will contain server.js (NOT public/).
DEPLOY_DIR=/greenly
# 1 = FTPS with explicit TLS (Plesk default), 0 = plain FTP
DEPLOY_TLS=1
