{
  "groups": {
    "aroid": {
      "label": "Obrazkowate (aroidy)",
      "summer": 8,
      "winter": 13,
      "note": "Podlewaj dopiero, gdy górne 3–4 cm podłoża przeschną. Lubią wysoką wilgotność powietrza, ale nie mokre korzenie.",
      "light": "Jasne rozproszone światło; bezpośrednie słońce parzy liście.",
      "humidity": "Lubi 50–70%; przy suchym powietrzu zraszaj albo postaw na tacce z keramzytem.",
      "temp": "18–27 °C, nie poniżej 15 °C, bez przeciągów.",
      "placement": "1–2 m od okna wschodniego lub zachodniego, z dala od grzejnika."
    },
    "succulent": {
      "label": "Sukulenty",
      "summer": 16,
      "winter": 35,
      "note": "Podlewaj obficie, ale rzadko — podłoże ma całkiem przeschnąć między podlewaniami.",
      "light": "Dużo światła — parapet południowy lub zachodni.",
      "humidity": "Suche powietrze nie przeszkadza.",
      "temp": "Lato 20–30 °C, zimą chłodniej (10–15 °C) i wtedy niemal bez podlewania.",
      "placement": "Najjaśniejszy parapet w domu; zimą chłodne, jasne miejsce."
    },
    "cactus": {
      "label": "Kaktusy",
      "summer": 18,
      "winter": 45,
      "note": "Zimą niemal bez wody. Stojąca woda w podstawce to najczęstsza przyczyna gnicia.",
      "light": "Pełne słońce.",
      "humidity": "Suche powietrze; nie zraszać.",
      "temp": "Lato ciepło, zima 8–15 °C i sucho — to warunek kwitnienia.",
      "placement": "Parapet południowy; zimą chłodno i jasno."
    },
    "fern": {
      "label": "Paprocie",
      "summer": 4,
      "winter": 6,
      "note": "Podłoże ma być stale lekko wilgotne, nigdy przesuszone. Przy suchym powietrzu zraszaj.",
      "light": "Półcień, rozproszone światło; słońce wypala liście.",
      "humidity": "Wysoka, 60%+; jasna łazienka to ideał.",
      "temp": "18–24 °C, stabilnie.",
      "placement": "Jasna łazienka albo głębsza część jasnego pokoju, z dala od grzejnika."
    },
    "marantaceae": {
      "label": "Marantowate",
      "summer": 5,
      "winter": 8,
      "note": "Wrażliwe na wapń — podlewaj wodą odstaną lub przefiltrowaną, najlepiej letnią.",
      "light": "Rozproszone światło; w słońcu liście blakną i zwijają się.",
      "humidity": "Wysoka, 60%+; przy suchym powietrzu brązowieją brzegi liści.",
      "temp": "18–26 °C; wrażliwe na przeciągi i zimno.",
      "placement": "Kilka metrów od okna, z dala od grzejnika; dobrze czują się w grupie roślin."
    },
    "ficus": {
      "label": "Fikusy",
      "summer": 9,
      "winter": 15,
      "note": "Nie przestawiaj bez potrzeby. Zrzucanie liści to zwykle reakcja na zmianę miejsca albo przelanie.",
      "light": "Jasno; odrobina porannego słońca nie zaszkodzi.",
      "humidity": "Średnia; co jakiś czas przetrzyj liście z kurzu.",
      "temp": "16–26 °C; nie lubi przeciągów i nagłych zmian.",
      "placement": "Stałe jasne miejsce przy oknie E/W — i nie przestawiaj."
    },
    "palm": {
      "label": "Palmy",
      "summer": 8,
      "winter": 14,
      "note": "Równomierna wilgotność bez zastoju wody. Brązowe końcówki liści to zwykle suche powietrze, nie brak wody.",
      "light": "Jasne rozproszone; młode liście parzą się w pełnym słońcu.",
      "humidity": "Średnia do wysokiej; zraszaj w sezonie grzewczym.",
      "temp": "18–24 °C, zimą nie poniżej 15 °C.",
      "placement": "Blisko jasnego okna, ale bez słońca w południe."
    },
    "orchid": {
      "label": "Storczyki",
      "summer": 7,
      "winter": 12,
      "note": "Podlewaj przez zanurzenie doniczki na 10 minut, potem dokładnie odsącz. Srebrne korzenie = czas podlać.",
      "light": "Jasne rozproszone; parapet wschodni jest idealny.",
      "humidity": "50–70%; nie zostawiaj wody w sercu rośliny.",
      "temp": "18–25 °C; do zawiązania pąków przydają się noce chłodniejsze o kilka stopni.",
      "placement": "Parapet wschodni lub północny, w przezroczystej doniczce."
    },
    "compact": {
      "label": "Zwarte (zamiokulkas, sansewieria)",
      "summer": 18,
      "winter": 35,
      "note": "Magazynują wodę w kłączach i liściach — lepiej podlać za rzadko niż za często.",
      "light": "Od jasnego po półcień — bardzo tolerancyjne.",
      "humidity": "Bez wymagań.",
      "temp": "15–28 °C.",
      "placement": "Praktycznie wszędzie poza pełnym słońcem; sprawdzają się w biurach i przedpokojach."
    },
    "citrus": {
      "label": "Cytrusy",
      "summer": 5,
      "winter": 10,
      "note": "Lubią miękką wodę i regularne podlewanie latem. Zimą chłodniej i wyraźnie oszczędniej.",
      "light": "Pełne słońce, minimum 5–6 h dziennie.",
      "humidity": "Średnia; zimą przy grzejniku zraszaj.",
      "temp": "Latem na balkon; zimą 5–12 °C i jasno.",
      "placement": "Latem balkon lub taras, zimą chłodne, jasne pomieszczenie."
    },
    "herb": {
      "label": "Zioła",
      "summer": 3,
      "winter": 5,
      "note": "Zioła w małych doniczkach wysychają szybko — sprawdzaj palcem podłoże co 2 dni. Rozmaryn i tymianek wolą przeschnąć.",
      "light": "Pełne słońce, parapet południowy.",
      "humidity": "Bez wymagań; zapewnij przewiew.",
      "temp": "18–25 °C.",
      "placement": "Najjaśniejszy parapet w kuchni, latem balkon."
    },
    "flowering": {
      "label": "Kwitnące",
      "summer": 5,
      "winter": 9,
      "note": "W czasie kwitnienia nie dopuszczaj do przeschnięcia bryły, bo roślina zrzuci pąki.",
      "light": "Jasno, poranne słońce; w pełnym południowym słońcu kwiaty szybko przekwitają.",
      "humidity": "Średnia.",
      "temp": "16–22 °C; chłodniej = dłuższe kwitnienie.",
      "placement": "Parapet wschodni; cyklameny i azalie wolą chłodne pokoje."
    },
    "begonia": {
      "label": "Begonie",
      "summer": 6,
      "winter": 10,
      "note": "Podlewaj od dołu lub przy brzegu doniczki — woda na liściach sprzyja mączniakowi.",
      "light": "Jasne rozproszone, bez ostrego słońca.",
      "humidity": "Wysoka, ale nie zraszaj liści.",
      "temp": "18–24 °C.",
      "placement": "Blisko okna wschodniego, z dala od grzejnika i przeciągów."
    },
    "universal": {
      "label": "Profil uniwersalny",
      "summer": 8,
      "winter": 13,
      "note": "Brak profilu dla tego gatunku — podlewaj, gdy wierzchnia warstwa podłoża przeschnie na 2–3 cm.",
      "light": "Jasne rozproszone światło to bezpieczny wybór dla większości roślin.",
      "humidity": "Średnia; większość roślin lubi więcej wilgoci, niż daje ogrzewane mieszkanie.",
      "temp": "18–24 °C.",
      "placement": "1–2 m od jasnego okna, z dala od grzejnika i przeciągów."
    }
  },
